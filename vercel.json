{
    "version": 2,
    "builds": [{
            "src": "api/index.py",
            "use": "@vercel/python"
        },
        {
            "src": "index.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [{
            "src": "/(questions|mcq)(.*)",
            "dest": "/api/index.py"
        },
        {
            "src": "/api.txt",
            "dest": "/api.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}